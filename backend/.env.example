# --- Application ---
APP_NAME=ElderCare Connect API
APP_VERSION=0.1.0
# development | staging | production
# "production" enables safety checks: explicit CORS origins (no "*"), DEBUG must be false, demo accounts off unless allowed.
ENVIRONMENT=development
DEBUG=false

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB Atlas ---
# Get this from Atlas: Database > Connect > Drivers. Never commit the real value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB_NAME=eldercare_connect
# How long to wait when selecting a server / pinging (milliseconds).
MONGODB_TIMEOUT_MS=5000

# --- Authentication (JWT) ---
# Required for /api/auth/*. Minimum 32 characters, random. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Backend only - never put this in the frontend env.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Invitations (Phase 3) ---
INVITATION_EXPIRY_HOURS=72
INVITATION_MAX_PENDING=10
REDEEM_MAX_FAILURES=5
REDEEM_FAILURE_WINDOW_MINUTES=15

# Sign-in throttling: after this many failed sign-ins for one email within the window, further attempts get 429.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MINUTES=15

# --- Medications (Phase 4) ---
# Doses are generated this many days ahead; a dose may be marked taken this many minutes early.
DOSE_SCHEDULE_HORIZON_DAYS=7
DOSE_EARLY_TAKE_MINUTES=120

# --- Demo accounts (sample data only) ---
# When true, `python -m app.scripts.seed_demo_accounts` may create the three demo
# accounts and the login page lists their credentials. Accounts are never created
# on startup. In ENVIRONMENT=production, DEMO_ACCOUNTS_ALLOW_PRODUCTION=true is also required.
DEMO_ACCOUNTS_ENABLED=false
DEMO_ACCOUNTS_ALLOW_PRODUCTION=false

# --- Notifications (Phase 7) ---
# A background thread checks for due reminders/alerts every NOTIFICATION_INTERVAL_SECONDS.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_INTERVAL_SECONDS=60
MISSED_DOSE_GRACE_MINUTES=60
# preview = never send (records "preview" in history; safe default). smtp = send via SMTP below.
EMAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# Frontend URL used for links inside emails.
APP_BASE_URL=http://localhost:5173
